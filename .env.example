# Copia este archivo a `.env.local` y completa los valores.  cp .env.example .env.local
# `.env.local` NUNCA se sube a git. Este archivo (.env.example) si, pero SIEMPRE vacio.
# Demo actual: la app corre sin ninguna de estas variables. Ver docs/IMPLEMENTAR.md.

# ---------- Supabase (base de datos + login) ----------
# Estas dos son seguras para el navegador (por eso llevan NEXT_PUBLIC_): la seguridad
# la ponen las politicas RLS de la base, no el secreto de la clave.
NEXT_PUBLIC_SUPABASE_URL=
# Clave "anon" o "publishable" del proyecto (Project Settings > API).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servidor: se salta RLS. SOLO scripts de importacion y el worker de Railway.
# JAMAS en el frontend ni con prefijo NEXT_PUBLIC_. No la cargues en Vercel salvo que
# un Route Handler de servidor la necesite de verdad.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Worker de tareas en segundo plano (Railway, pg-boss) ----------
# Cadena de conexion de Postgres (Supabase > Connect). Solo vive en Railway y en tu .env.local.
DATABASE_URL=

# ---------- IA (solo servidor: Route Handlers / Server Actions) ----------
OPENAI_API_KEY=
# Nombre del modelo que elijas en tu cuenta (no lo dejamos fijo en el codigo).
OPENAI_MODEL=
# Alternativa a OpenAI:
GEMINI_API_KEY=
